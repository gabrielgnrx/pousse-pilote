# Supabase : Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# URL publique de l'application (pour les liens de connexion par e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Rappels sur téléphone : clé privée VAPID (secrète, jamais préfixée par NEXT_PUBLIC_).
# La purge des photos et les tâches planifiées n'ont besoin d'aucun secret ici (Supabase, migration 0044).
VAPID_PRIVATE_KEY=

# Optionnel : contact transmis à Open Food Facts (en-tête User-Agent du scanner)
OFF_CONTACT=

