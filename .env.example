# Supabase : Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# URL publique de l'application (pour les liens de connexion par e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Uniquement pour la purge automatique des photos de plus de 90 jours (Vercel Cron).
# Clé secrète : ne jamais la préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=une-longue-chaine-aleatoire

# Optionnel : contact transmis à Open Food Facts (en-tête User-Agent du scanner)
OFF_CONTACT=

# API Claude (serveur uniquement, jamais préfixée par NEXT_PUBLIC_). Sans clé, l'IA est désactivée
# et l'application propose ses replis (raccourcis, formulaire manuel).
ANTHROPIC_API_KEY=
# 1 = réponses IA simulées et déterministes (tests de bout en bout, démo sans clé).
AI_MOCK=
